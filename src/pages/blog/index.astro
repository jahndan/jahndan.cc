---
import CommonLayout from "/src/layouts/CommonLayout.astro";
import { getCollection } from "astro:content";

interface T {
  data: { date: Date };
}
const cmp = ({ data: { date: a } }: T, { data: { date: b } }: T) => {
  return new Date(b).valueOf() - new Date(a).valueOf();
};

const posts = await getCollection("posts");
posts.sort(cmp);

const frontmatter = {
  title: "all blog posts",
};

/*
<CommonLayout frontmatter={frontmatter}>
  <article>
    <p>all blog posts:</p>
    <ul>
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`}>
              <strong>{post.data.title}</strong>
              <small>{post.data.date.toLocaleDateString()}</small>
              <small>{post.data.description}</small>
            </a>
          </li>
        ))
      }
    </ul>
  </article>
</CommonLayout>
*/
---

<CommonLayout frontmatter={frontmatter}>
  <article>
    <div
      style={{
        display: "flex",
        flexDirection: "column",
        alignItems: "center",
        justifyContent: "center",
        height: "72svh",
